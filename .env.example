# PostgreSQL local
POSTGRES_DB=heroforce
POSTGRES_USER=heroforce
POSTGRES_PASSWORD=heroforce_dev
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql://heroforce:heroforce_dev@localhost:5432/heroforce
API_PORT=3000
JWT_SECRET=replace-this-with-a-long-local-development-secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# Seed controlado de administrador (não usado pelo cadastro público)
# ADMIN_NAME=Administrador HeroForce
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password
# ADMIN_CHARACTER=Nick Fury

# Frontend
FRONTEND_URL=http://localhost:5173

